{
	"kind": "gajae-code-plugin",
	"name": "jbcontext",
	"version": "0.4.0",
	"tools": [
		{
			"name": "code_search",
			"path": "tools/code-search.ts",
			"description": "Semantic code search over the jbcontext index"
		}
	],
	"hooks": [
		{
			"name": "auto-index",
			"event": "session_start",
			"path": "hooks/auto-index.ts"
		}
	],
	"system_appendix": [
		{
			"name": "jbcontext-usage",
			"path": "prompts/system-appendix.md"
		}
	]
}
